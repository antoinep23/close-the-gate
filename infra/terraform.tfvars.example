# Copy to terraform.tfvars and adjust. All values are optional

region      = "eu-west-1"
name_prefix = "close-the-gate"

# Force exact names (otherwise derived from name_prefix + account id).
# bucket_name = "my-ctg-bucket-123456789012"
# table_name  = "my-ctg-files"

# Effective share-link lifetime (S3 lifecycle on shared/).
share_expiration_days = 2

# Cap the public share endpoint's cost / blast radius (THREAT_MODEL N10).
lambda_reserved_concurrency = 10

# Attach the least-privilege app policy to the principal(s) running the app.
# Accepts IAM user and/or role ARNs. Leave empty to attach it manually.
# app_principal_arns = ["arn:aws:iam::123456789012:user/ctg-app"]

tags = {
  Project   = "close-the-gate"
  ManagedBy = "terraform"
}
